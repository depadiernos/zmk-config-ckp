#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------
            // | ESC |  1  |  2  |  3  |  4  |  5  |  6  |  7  |  8  |  9  |  0  |  -  |  =  |BKSP | DEL |
            // | TAB  |  Q  |  W  |  E  |  R  |  T  |  Y  |  U  |  I  |  O  |  P  |  [  |  ]  |  |   |
            // | CAPS  |  A  |  S  |  D  |  F  |  G  |  H  |  J  |  K  |  L  |  ;  |  '  |     ENTER    |
            // |  SHIFT|NONE|  Z  |  X  |  C  |  V  |  B  |  N  |  M  |  ,  |  .  | /   | SHFT | UP | 1  |
            // |  CTL  |  ALT  |  WIN  |            SPACE              | WIN | ALT | LEFT | DOWN | RIGHT |
            // ------------------------------------------------------------------------------------------

            bindings = <
&kp GRAVE  &kp N1     &kp N2        &kp N3         &kp N4     &kp N5          &kp N6         &kp N7    &kp N8    &kp N9     &kp N0    &kp MINUS  &kp EQUAL  &kp BSPC  &kp C_MUTE
&kp TAB    &kp Q      &kp W         &kp E          &kp R      &kp T           &kp Y          &kp U     &kp I     &kp O      &kp P     &kp LBKT   &kp RBKT   &kp BSLH
&kp CLCK   &kp A      &kp S         &kp D          &kp F      &kp G           &kp H          &kp J     &kp K     &kp L      &kp SEMI  &kp SQT    &kp RET
&kp LSHFT  &none      &kp Z         &kp X          &kp C      &kp V           &kp B          &kp N     &kp M     &kp COMMA  &kp DOT   &kp FSLH   &kp RSHFT  &kp UP    &mo 1
           &kp LCTRL  &kp LEFT_ALT  &kp LEFT_META  &kp SPACE  &kp RIGHT_META  &kp RIGHT_ALT  &kp LEFT  &kp DOWN  &kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise {
            bindings = <
&kp ESC  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7    &kp F8     &kp F9   &kp F10  &kp F11  &kp F12  &kp DEL    &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans   &trans   &trans   &trans   &trans
&mo 2   &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans   &trans   &trans   &trans
&trans   &none   &trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans   &trans   &trans   &trans   &kp PG_UP  &trans
         &trans  &trans  &trans  &trans  &trans  &trans  &kp HOME  &kp PG_DN  &kp END
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        system {
            bindings = <
&sys_reset  &trans          &trans           &trans        &trans       &trans  &trans  &trans      &trans        &trans      &trans  &trans  &trans  &trans      &trans
&trans      &trans          &trans           &trans        &trans       &trans  &trans  &trans      &trans        &trans      &trans  &trans  &trans  &trans
&trans      &bt BT_CLR_ALL  &trans           &trans        &trans       &trans  &trans  &trans      &trans        &trans      &trans  &trans  &trans
&trans      &trans          &trans           &trans        &trans       &trans  &trans  &trans      &trans        &trans      &trans  &trans  &trans  &bt BT_CLR  &trans
            &trans          &rgb_ug RGB_TOG  &out OUT_TOG  &bootloader  &trans  &trans  &bt BT_PRV  &bt BT_SEL 0  &bt BT_NXT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
